# KALIMA : variables d'environnement (exemple sans secret).
# Copiez ce fichier en .env.local pour le développement ; en production,
# renseignez ces valeurs dans les réglages du projet Vercel.

# --- Site -------------------------------------------------------------------
# Adresse publique du site (liens des e-mails, cookies sécurisés en https).
APP_URL=http://localhost:3000
# "preview" = préproduction (bandeau, non indexée, mode e-mail « log » autorisé).
# "production" uniquement pour la boutique ouverte.
NEXT_PUBLIC_SITE_ENV=preview

# --- Base de données PostgreSQL (Supabase) -------------------------------------
# En production : chaîne du « Transaction pooler » Supabase (port 6543).
DATABASE_URL=postgres://kalima:kalima@localhost:5432/kalima
DATABASE_POOL_SIZE=5

# --- Sécurité -------------------------------------------------------------------
# Au moins 32 caractères aléatoires (ex. : openssl rand -hex 32).
SESSION_SECRET=remplacez-par-une-valeur-aleatoire-de-64-caracteres
# Protège la tâche planifiée /api/cron (Vercel l'envoie automatiquement).
CRON_SECRET=remplacez-par-une-autre-valeur-aleatoire

# --- E-mails (Brevo) --------------------------------------------------------------
# "brevo" en production. "log" (préproduction locale uniquement) écrit les e-mails
# dans le dossier .outbox sans rien envoyer. Vide = aucun envoi (échecs visibles).
EMAIL_PROVIDER=log
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=commandes@votre-domaine.sn
EMAIL_FROM_NAME=KALIMA
EMAIL_REPLY_TO=

# --- Photos des produits (Supabase Storage) ---------------------------------------
# Sans ces variables, les photos sont stockées dans .uploads (développement uniquement).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=produits
# Domaine des photos pour l'optimisation d'images (ex. abcd1234.supabase.co).
STORAGE_PUBLIC_HOST=
